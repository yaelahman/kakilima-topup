# NEXT_PUBLIC_SITE_DESCRIPTION=

# API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_IMAGE_URL=
NEXT_PUBLIC_IMAGE_URL_API=http://localhost:8000/storage
